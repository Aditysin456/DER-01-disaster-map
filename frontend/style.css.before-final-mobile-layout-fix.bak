* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  font-family: "Inter", sans-serif;
  background: #091421;
  color: #d9e3f6;
}

button,
input {
  font: inherit;
}

button {
  -webkit-tap-highlight-color: transparent;
}

#map {
  width: 100%;
  height: 100vh;
  padding-top: 56px;
  box-sizing: border-box;
}

#appHeader {
  position: absolute;
  top: 10px;
  left: 10px;
  z-index: 1000;
  display: flex;
  align-items: center;
  gap: 10px;
  width: auto;
  height: 46px;
  padding: 0 10px 0 16px;
  border: 1px solid rgba(133, 169, 194, 0.28);
  border-radius: 999px;
  background: rgba(11, 20, 32, 0.95);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  box-shadow:
    0 8px 25px rgba(0, 0, 0, 0.35),
    inset 0 1px 0 rgba(255, 255, 255, 0.04);
}

#appTitle {
  font-size: 12px !important;
  font-weight: 700;
  letter-spacing: -0.01em;
  white-space: nowrap;
}

#appHeader::before {
  content: "";
  width: 11px;
  height: 11px;
  flex: 0 0 11px;
  border-radius: 50%;
  background: #18d8ff;
  box-shadow:
    0 0 8px rgba(24, 216, 255, 0.9),
    0 0 16px rgba(24, 216, 255, 0.4);
}

#liveBadge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  height: 28px;
  padding: 0 10px;
  border: 1px solid rgba(32, 190, 255, 0.5);
  border-radius: 999px;
  background: rgba(15, 64, 88, 0.3);
  color: #53d8ff;
  font-family: "JetBrains Mono", monospace;
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.08em;
}

.livePulse {
  width: 7px;
  height: 7px;
  flex: 0 0 7px;
  border-radius: 50%;
  background: #129fc9;
  box-shadow: 0 0 7px rgba(18, 159, 201, 0.75);
}

#pointerCursor {
  position: fixed;
  width: 30px;
  height: 30px;
  z-index: 2000;
  pointer-events: none;
  display: none;
  transform: translate(-50%, -50%);
}

.pointerHorizontal,
.pointerVertical {
  position: absolute;
  background: rgba(82, 222, 255, 0.9);
  box-shadow: 0 0 6px rgba(82, 222, 255, 0.6);
}

.pointerHorizontal {
  width: 30px;
  height: 1px;
  left: 0;
  top: 14px;
}

.pointerVertical {
  width: 1px;
  height: 30px;
  left: 14px;
  top: 0;
}

.pointerCenter {
  position: absolute;
  width: 8px;
  height: 8px;
  left: 11px;
  top: 11px;
  border: 1px solid #5cddff;
  border-radius: 50%;
  box-shadow: 0 0 8px rgba(82, 222, 255, 0.65);
}

.leaflet-top.leaflet-left {
  top: 68px !important;
}

.leaflet-control-zoom a {
  width: 34px !important;
  height: 34px !important;
  line-height: 32px !important;
  margin-bottom: 6px !important;
  border: 1px solid rgba(133, 169, 194, 0.25) !important;
  border-radius: 50% !important;
  background: rgba(10, 14, 20, 0.9) !important;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  color: #d9e3f6 !important;
  text-align: center;
  box-shadow: 0 5px 14px rgba(0, 0, 0, 0.3);
}

.leaflet-control-zoom a:hover {
  background: rgba(18, 37, 52, 0.95) !important;
  color: #47d6ff !important;
  border-color: rgba(71, 214, 255, 0.5) !important;
}

#reportForm {
  position: absolute;
  top: 76px;
  right: 20px;
  z-index: 1000;
  width: 350px;
  max-height: calc(100vh - 96px);
  overflow-y: auto;
  background: rgba(10, 14, 20, 0.9);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding: 20px;
  border-radius: 8px;
  border: 1px solid rgba(255, 255, 255, 0.15);
  box-shadow: 0 0 30px rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  gap: 12px;
}

#reportForm::-webkit-scrollbar {
  width: 4px;
}

#reportForm::-webkit-scrollbar-thumb {
  background: rgba(130, 167, 190, 0.3);
  border-radius: 99px;
}

.reportFormHeader {
  display: flex;
  align-items: center;
  gap: 11px;
  padding-bottom: 13px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.reportFormIcon {
  width: 35px;
  height: 35px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(73, 216, 255, 0.3);
  border-radius: 8px;
  background: rgba(46, 190, 229, 0.08);
  color: #59dcff;
}

#reportForm h3 {
  margin: 0;
  color: #d9e3f6;
  font-size: 16px;
  font-weight: 600;
}

.formSubtitle {
  display: block;
  margin-top: 3px;
  color: #748b9e;
  font-family: "JetBrains Mono", monospace;
  font-size: 9px;
}

#sourceToggle {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3px;
  padding: 3px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 6px;
  background: rgba(7, 15, 25, 0.75);
}

.sourceTab {
  min-height: 35px;
  border: 0;
  border-radius: 5px;
  background: transparent;
  color: #7d93a5;
  font-size: 10px;
  font-weight: 600;
  cursor: pointer;
}

.sourceTabActive {
  background: rgba(52, 193, 230, 0.13);
  color: #91e8ff;
  box-shadow: inset 0 0 0 1px rgba(73, 216, 255, 0.24);
}

.quickCaptureHeader {
  color: #8299ab;
  font-family: "JetBrains Mono", monospace;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.13em;
}

.quickCaptureRow {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

.captureBtn {
  min-height: 52px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 8px;
  border: 1px solid rgba(151, 190, 219, 0.18);
  border-radius: 8px;
  background: rgba(12, 28, 42, 0.78);
  color: #c8d8e5;
  font-size: 10px;
  font-weight: 600;
  cursor: pointer;
  transition: 0.18s ease;
}

.captureBtn:hover {
  border-color: rgba(73, 216, 255, 0.48);
  background: rgba(20, 50, 67, 0.8);
  color: #e3f9ff;
}

.captureIcon {
  width: 27px;
  height: 27px;
  display: grid;
  place-items: center;
  border-radius: 7px;
  background: rgba(73, 216, 255, 0.08);
  color: #58dfff;
}

.fileNameDisplay {
  min-height: 34px;
  display: flex;
  align-items: center;
  padding: 0 11px;
  border: 1px dashed rgba(151, 190, 219, 0.2);
  border-radius: 6px;
  color: #7890a2;
  font-family: "JetBrains Mono", monospace;
  font-size: 9px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

#gpsStatusCard {
  min-height: 57px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 10px;
  border: 1px solid rgba(73, 216, 255, 0.17);
  border-radius: 8px;
  background: rgba(11, 31, 44, 0.65);
}

.gpsStatusIcon {
  width: 30px;
  height: 30px;
  flex: 0 0 30px;
  display: grid;
  place-items: center;
  border-radius: 7px;
  color: #5edfff;
  background: rgba(73, 216, 255, 0.09);
}

.gpsStatusText {
  min-width: 0;
}

#gpsStatusCard strong {
  display: block;
  color: #cfe4f1;
  font-size: 10px;
  font-weight: 700;
}

#gpsSourceNote {
  display: block;
  margin-top: 3px;
  color: #72899a;
  font-family: "JetBrains Mono", monospace;
  font-size: 8px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

#refreshGpsBtn {
  width: 29px;
  height: 29px;
  flex: 0 0 29px;
  margin-left: auto;
  display: grid;
  place-items: center;
  padding: 0;
  border: 1px solid rgba(151, 190, 219, 0.18);
  border-radius: 7px;
  background: rgba(7, 20, 31, 0.75);
  color: #88a5b8;
  cursor: pointer;
}

#refreshGpsBtn:hover {
  color: #5cddff;
  border-color: rgba(73, 216, 255, 0.45);
}

#refreshGpsBtn.is-loading svg {
  animation: spin 0.8s linear infinite;
}

.submitReportBtn {
  width: 100%;
  min-height: 45px;
  border: 1px solid rgba(100, 230, 255, 0.45);
  border-radius: 6px;
  background: #a5e7ff;
  color: #003543;
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
}

.submitReportBtn:hover {
  background: #c8f2ff;
}

.submitReportBtn:disabled {
  background: #454950;
  color: #b5b8c1;
  cursor: not-allowed;
  opacity: 0.85;
}

.submitReportBtn.loading::after {
  content: "";
  display: inline-block;
  width: 12px;
  height: 12px;
  margin-left: 8px;
  border: 2px solid rgba(0, 53, 67, 0.4);
  border-top-color: #003543;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
  vertical-align: middle;
}

#queueBadge {
  padding: 8px 10px;
  border: 1px solid rgba(255, 176, 54, 0.32);
  border-radius: 6px;
  background: rgba(255, 176, 54, 0.08);
  color: #ffbe59;
  font-family: "JetBrains Mono", monospace;
  font-size: 9px;
}

#bottomLeftCards {
  position: absolute;
  left: 20px;
  bottom: 20px;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  gap: 10px;
}

#legend {
  width: 115px;
  min-width: 115px;
  padding: 12px 13px;
  border: 1px solid rgba(133, 169, 194, 0.25);
  border-radius: 12px;
  background: rgba(7, 17, 29, 0.92);
  box-shadow:
    0 12px 30px rgba(0, 0, 0, 0.35),
    inset 0 1px 0 rgba(255, 255, 255, 0.025);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.legendTitle {
  margin-bottom: 9px;
  color: #8295a6;
  font-family: "JetBrains Mono", monospace;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.12em;
}

#legend div:not(.legendTitle) {
  display: flex;
  align-items: center;
  gap: 9px;
  margin: 8px 0;
  color: #d8e4ed;
  font-family: "Inter", sans-serif;
  font-size: 11px;
  font-weight: 600;
}

.dot {
  width: 10px;
  height: 10px;
  min-width: 10px;
  border-radius: 50%;
  display: inline-block;
}

.highDot {
  background: #ff5367;
  box-shadow:
    0 0 7px rgba(255, 83, 103, 0.8),
    0 0 14px rgba(255, 83, 103, 0.3);
}

.mediumDot {
  background: #ffad18;
  box-shadow:
    0 0 7px rgba(255, 173, 24, 0.8),
    0 0 14px rgba(255, 173, 24, 0.3);
}

.lowDot {
  background: #00f59b;
  box-shadow:
    0 0 7px rgba(0, 245, 155, 0.8),
    0 0 14px rgba(0, 245, 155, 0.3);
}

#currentLocationCard {
  width: 200px;
  min-width: 200px;
  padding: 10px 12px 11px;
  border: 1px solid rgba(133, 169, 194, 0.25);
  border-radius: 14px;
  background: rgba(10, 18, 30, 0.94);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  box-shadow:
    0 10px 28px rgba(0, 0, 0, 0.35),
    inset 0 1px 0 rgba(255, 255, 255, 0.025);
}

.currentLocationHeader {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12px;
  padding-bottom: 8px;
}

.currentLocationActions {
  display: flex;
  align-items: center;
  gap: 4px;
}

.currentLocationHeader > span {
  color: #8194a5;
  font-family: "JetBrains Mono", monospace;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.11em;
  white-space: nowrap;
}

.currentLocationActions {
  display: flex;
  align-items: center;
  gap: 4px;
}

.currentLocationActions button {
  width: 29px;
  height: 29px;
  display: grid;
  place-items: center;
  padding: 0;
  border: 1px solid rgba(133, 169, 194, 0.2);
  border-radius: 8px;
  background: rgba(13, 27, 41, 0.9);
  color: #9db2c1;
  cursor: pointer;
}

.currentLocationActions button:hover,
.currentLocationActions button.located,
.currentLocationActions button.copied {
  color: #5adfff;
  border-color: rgba(73, 216, 255, 0.48);
  background: rgba(23, 49, 65, 0.95);
}

.currentLocationRow {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 7px;
  padding-top: 8px;
  color: #a7b8c6;
  font-family: "JetBrains Mono", monospace;
  font-size: 10px;
  font-weight: 500;
  white-space: nowrap;
}

.currentLocationRow span {
  color: #91dcff;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.switch {
  position: relative;
  display: inline-block;
  width: 45px;
  height: 25px;
}

.switch input {
  opacity: 0;
  width: 0;
  height: 0;
}

.switch .slider {
  position: absolute;
  inset: 0;
  cursor: pointer;
  background: #253745;
  border: 1px solid rgba(151, 190, 219, 0.2);
  border-radius: 24px;
  transition: 0.2s;
}

.switch .slider:before {
  position: absolute;
  content: "";
  width: 19px;
  height: 19px;
  left: 2px;
  bottom: 2px;
  background: #c7d6e0;
  border-radius: 50%;
  transition: 0.2s;
}

.switch input:checked + .slider {
  background: rgba(32, 159, 190, 0.4);
  border-color: rgba(73, 216, 255, 0.45);
}

.switch input:checked + .slider:before {
  transform: translateX(20px);
  background: #5cddff;
}

.leaflet-popup-content-wrapper {
  background: rgba(6, 15, 26, 0.95) !important;
  color: #dce9f3 !important;
  border: 1px solid rgba(151, 190, 219, 0.22) !important;
  border-radius: 8px !important;
  box-shadow: 0 18px 45px rgba(0, 0, 0, 0.42) !important;
  backdrop-filter: blur(15px);
}

.leaflet-popup-content {
  margin: 12px !important;
  font-family: "Inter", sans-serif !important;
}

.leaflet-popup-tip {
  background: rgba(6, 15, 26, 0.95) !important;
}

.leaflet-popup-close-button {
  color: #7e95a6 !important;
}

.leaflet-popup-close-button:hover {
  color: #5cddff !important;
}

#accessOverlay {
  position: fixed;
  inset: 0;
  z-index: 3000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(2, 8, 15, 0.68);
  backdrop-filter: blur(7px);
  -webkit-backdrop-filter: blur(7px);
}

#accessOverlay.hidden {
  display: none;
}

#accessModal {
  width: 420px;
  max-width: 90vw;
  padding: 26px;
  border: 1px solid rgba(151, 190, 219, 0.25);
  border-radius: 10px;
  background: rgba(6, 15, 26, 0.96);
  color: #dce8f2;
  box-shadow: 0 25px 70px rgba(0, 0, 0, 0.55);
}

#accessModalHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 7px;
}

#accessModalHeader h2 {
  margin: 0;
  font-size: 20px;
}

#accessCloseBtn {
  border: 0;
  background: transparent;
  color: #71899b;
  font-size: 24px;
  cursor: pointer;
}

#accessCloseBtn:hover {
  color: #fff;
}

#accessModalSubtitle {
  margin: 0 0 18px;
  color: #8298a9;
  font-size: 12px;
}

.permissionRow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 9px;
  padding: 13px 14px;
  border: 1px solid rgba(151, 190, 219, 0.15);
  border-radius: 7px;
  background: rgba(9, 24, 37, 0.72);
  font-size: 13px;
}

#accessApplyBtn {
  width: 100%;
  margin-top: 8px;
  min-height: 42px;
  border: 1px solid rgba(100, 230, 255, 0.45);
  border-radius: 6px;
  background: #a5e7ff;
  color: #003543;
  font-weight: 700;
  cursor: pointer;
}

#cameraModal {
  position: fixed;
  inset: 0;
  z-index: 5000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: rgba(2, 8, 15, 0.82);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

#cameraBox {
  width: min(520px, 92vw);
  padding: 16px;
  border: 1px solid rgba(73, 216, 255, 0.35);
  border-radius: 10px;
  background: rgba(6, 15, 26, 0.97);
  box-shadow: 0 25px 70px rgba(0, 0, 0, 0.6);
}

#cameraPreview {
  display: block;
  width: 100%;
  max-height: 65vh;
  object-fit: cover;
  border-radius: 7px;
  background: #000;
}

#cameraActions {
  display: flex;
  gap: 10px;
  margin-top: 12px;
}

#cameraActions button {
  flex: 1;
  min-height: 44px;
  border: 1px solid rgba(73, 216, 255, 0.35);
  border-radius: 6px;
  background: rgba(14, 42, 57, 0.9);
  color: #dff8ff;
  font-weight: 700;
  cursor: pointer;
}

#takePhotoBtn {
  background: #a5e7ff !important;
  color: #003543 !important;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

@media (max-width: 850px) {
  #reportForm {
    width: 320px;
    right: 12px;
  }

  #bottomLeftCards {
    left: 12px;
    bottom: 12px;
  }
}

@media (max-width: 650px) {
  #appHeader {
    padding: 14px 16px;
  }

  #appTitle {
    font-size: 13px;
  }

  #reportForm {
    top: 68px;
    right: 8px;
    width: min(330px, calc(100vw - 16px));
    max-height: calc(100vh - 76px);
  }

#bottomLeftCards {
  position: absolute;
  left: 20px;
  bottom: 20px;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  gap: 8px;
}

  #currentLocationCard {
    width: 240px;
    min-width: 240px;
  }
}

.headerDivider {
  width: 1px;
  height: 22px;
  flex: 0 0 1px;
  background: rgba(180, 200, 215, 0.25);
}
.reportFormHeader {
  position: relative;
}
#reportForm.collapsed {
  padding-bottom: 20px;
  gap: 0;
}
#reportForm.collapsed > *:not(.reportFormHeader) {
  display: none;
}
#minimizeFormBtn {
  flex-shrink: 0;
}


/* Clean mobile report-panel layout */
.reportFormHeader {
  position: relative;
  justify-content: center;
}

#minimizeFormBtn {
  position: absolute;
  top: 0;
  right: 0;
  width: 34px;
  height: 34px;
  padding: 0;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  border: 1px solid rgba(73, 216, 255, 0.3);
  border-radius: 8px;
  background: rgba(46, 190, 229, 0.08);
  color: #59dcff;
  font-size: 22px;
  line-height: 1;
  cursor: pointer;
}

#minimizeFormBtn:hover {
  background: rgba(46, 190, 229, 0.18);
}

#reportForm.collapsed {
  padding-bottom: 20px;
  gap: 0;
}

#reportForm.collapsed > *:not(.reportFormHeader) {
  display: none;
}

@media (max-width: 650px) {
  #reportForm {
    top: 68px;
    left: 50%;
    right: auto;
    transform: translateX(-50%);
    width: min(330px, calc(100vw - 16px));
    max-height: calc(100dvh - 76px);
  }
}

/* Final header layout: left title, plain + / − at top-right */
.reportFormHeader {
  position: relative;
  justify-content: flex-start;
}

#minimizeFormBtn {
  position: absolute;
  top: 2px;
  right: 0;
  width: 28px;
  height: 28px;
  padding: 0;
  display: grid;
  place-items: center;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #59dcff;
  font-size: 26px;
  font-weight: 400;
  line-height: 1;
  box-shadow: none;
  cursor: pointer;
}

#minimizeFormBtn:hover,
#minimizeFormBtn:focus {
  background: transparent;
  color: #8be8ff;
  outline: none;
}

/* Compact dashboard map-theme popover */
#appHeader {
  position: relative;
}

#mapThemeMenu {
  position: absolute;
  top: calc(100% + 8px);
  left: 0;
  z-index: 1200;
}

#mapThemeToggle {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 7px 10px;
  border: 1px solid rgba(73, 216, 255, 0.3);
  border-radius: 7px;
  background: rgba(10, 20, 30, 0.94);
  color: #d9e3f6;
  font: 600 11px "Inter", sans-serif;
  cursor: pointer;
  box-shadow: 0 7px 18px rgba(0, 0, 0, 0.24);
}

.themeChevron {
  color: #59dcff;
  font-size: 14px;
  line-height: 1;
  transition: transform 0.2s ease;
}

#mapThemeMenu.is-open .themeChevron {
  transform: rotate(180deg);
}

#mapThemePanel {
  display: none;
  width: 330px;
  margin-top: 8px;
  padding: 15px;
  border: 1px solid rgba(73, 216, 255, 0.2);
  border-radius: 13px;
  background: rgba(13, 24, 37, 0.97);
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.38);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

#mapThemeMenu.is-open #mapThemePanel {
  display: block;
}

.mapThemePanelHeading {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12px;
  color: #8ea6b8;
  font: 700 9px "JetBrains Mono", monospace;
  letter-spacing: 0.08em;
}

.mapThemeOptions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 9px;
}

.mapThemeOption {
  min-height: 68px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7px;
  border: 1px solid transparent;
  border-radius: 9px;
  background: #101b2b;
  color: #b8c6d5;
  font: 600 11px "Inter", sans-serif;
  cursor: pointer;
}

.mapThemeOption:hover,
.mapThemeOption.is-active {
  border-color: rgba(73, 216, 255, 0.62);
  background: rgba(28, 101, 130, 0.38);
  color: #59dcff;
}

.themeIcon {
  color: #59dcff;
  font-size: 18px;
  line-height: 1;
}

@media (max-width: 650px) {
  #mapThemePanel {
    width: min(330px, calc(100vw - 24px));
  }
}

/* Compact dashboard again; only the arrow is visible initially */
#appHeader {
  width: fit-content !important;
  max-width: calc(100vw - 24px);
  right: auto !important;
  position: absolute;
}

#mapThemeMenu {
  position: relative;
  top: auto;
  left: auto;
  right: auto;
  display: flex;
  align-items: center;
  z-index: 1200;
  margin-left: 2px;
}

#mapThemeToggle {
  width: 25px;
  height: 28px;
  padding: 0;
  display: grid;
  place-items: center;
  border: 0;
  border-left: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

#activeMapTheme {
  display: none;
}

.themeChevron {
  font-size: 15px;
  color: #8ea6b8;
}

/* The wide map-theme menu exists only after clicking the arrow */
#mapThemePanel {
  position: absolute;
  top: calc(100% + 10px);
  right: 0;
  left: auto;
  width: 330px;
  margin: 0;
}

@media (max-width: 650px) {
  #appHeader {
    max-width: calc(100vw - 16px);
  }

  #mapThemePanel {
    width: min(330px, calc(100vw - 16px));
  }
}

/* Prevent the mobile map-theme panel from overlapping the report form */
@media (max-width: 650px) {
  body.map-theme-open #reportForm {
    top: 365px;
    max-height: calc(100dvh - 380px);
  }

  #mapThemePanel {
    z-index: 1300;
  }
}
